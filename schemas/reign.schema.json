

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MI Wrestling Championship Reign",
  "type": "object",
  "required": ["id", "championshipId", "status"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
    },
    "championshipId": {
      "type": "string"
    },
    "championWrestlerIds": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "championTeamId": {
      "type": ["string", "null"]
    },
    "status": {
      "type": "string",
      "enum": ["active", "ended", "vacant", "unknown"]
    },
    "startDate": {
      "type": ["string", "null"],
      "format": "date"
    },
    "endDate": {
      "type": ["string", "null"],
      "format": "date"
    },
    "eventId": {
      "type": ["string", "null"]
    },
    "matchId": {
      "type": ["string", "null"]
    },
    "previousReignId": {
      "type": ["string", "null"]
    },
    "notes": {
      "type": ["string", "null"]
    }
  },
  "additionalProperties": true
}
