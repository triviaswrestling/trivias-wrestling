

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MI Wrestling Trivia Question",
  "type": "object",
  "required": ["id", "question"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "answers": {
      "type": "array",
      "items": {"type": "string"}
    },
    "correctAnswer": {
      "type": ["string", "null"]
    },
    "category": {
      "type": ["string", "null"]
    },
    "difficulty": {
      "type": ["string", "null"]
    },
    "sourceTournamentId": {
      "type": ["string", "null"]
    },
    "sourceEventId": {
      "type": ["string", "null"]
    },
    "notes": {
      "type": ["string", "null"]
    }
  },
  "additionalProperties": true
}
