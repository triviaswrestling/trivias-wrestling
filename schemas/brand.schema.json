

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MI Wrestling Brand",
  "type": "object",
  "required": ["id", "name"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "promotionId": {
      "type": ["string", "null"]
    },
    "color": {
      "type": ["string", "null"]
    },
    "logo": {
      "type": ["string", "null"]
    },
    "description": {
      "type": ["string", "null"]
    },
    "status": {
      "type": ["string", "null"]
    },
    "order": {
      "type": ["integer", "null"],
      "minimum": 0
    }
  },
  "additionalProperties": true
}
