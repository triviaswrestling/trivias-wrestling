

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MI Wrestling Team",
  "type": "object",
  "required": ["id", "name"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": ["string", "null"]
    },
    "memberWrestlerIds": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "brandIds": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "image": {
      "type": ["string", "null"]
    },
    "startDate": {
      "type": ["string", "null"],
      "format": "date"
    },
    "endDate": {
      "type": ["string", "null"],
      "format": "date"
    },
    "status": {
      "type": ["string", "null"]
    },
    "achievements": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "additionalProperties": true
}
