

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MI Wrestling Event",
  "type": "object",
  "required": ["id", "title"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": ["string", "null"]
    },
    "date": {
      "type": ["string", "null"],
      "format": "date"
    },
    "brandIds": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "promotionIds": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "seasonId": {
      "type": ["string", "null"]
    },
    "matchIds": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "status": {
      "type": "string",
      "enum": ["scheduled", "completed", "cancelled", "unknown"],
      "default": "unknown"
    },
    "order": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "description": {
      "type": ["string", "null"]
    }
  },
  "additionalProperties": true
}
