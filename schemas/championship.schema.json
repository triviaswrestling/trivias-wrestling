
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MI Wrestling Championship",
  "type": "object",
  "required": ["id", "name"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": ["string", "null"]
    },
    "status": {
      "type": "string",
      "enum": ["active", "inactive", "vacant", "retired", "unknown"],
      "default": "unknown"
    },
    "promotionId": {
      "type": ["string", "null"]
    },
    "image": {
      "type": ["string", "null"]
    },
    "currentReignId": {
      "type": ["string", "null"]
    },
    "order": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "description": {
      "type": ["string", "null"]
    }
  },
  "additionalProperties": true
}

