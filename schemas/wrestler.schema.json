{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MI Wrestling Wrestler",
  "type": "object",
  "required": [
    "id",
    "name"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "nickname": {
      "type": [
        "string",
        "null"
      ]
    },
    "interpreter": {
      "type": [
        "string",
        "null"
      ],
      "description": "ID del intérprete actual, no es otro luchador"
    },
    "image": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "type": [
        "string",
        "null"
      ]
    },
    "division": {
      "type": [
        "string",
        "null"
      ]
    },
    "brand": {
      "type": [
        "string",
        "null"
      ]
    },
    "attributes": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "power": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "charisma": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "micro": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
      },
      "additionalProperties": true
    },
    "interpreterHistory": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "current": {
            "type": "boolean"
          },
          "recordUrl": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "record": {
      "type": "object",
      "properties": {
        "season2026": {
          "type": "string"
        },
        "career": {
          "type": "string"
        }
      }
    },
    "legacyStats": {
      "type": "object"
    },
    "finisher": {
      "type": [
        "string",
        "null"
      ]
    },
    "signature": {
      "type": [
        "string",
        "null"
      ]
    },
    "achievements": {
      "type": "array"
    },
    "presentationIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "recordLinks": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
