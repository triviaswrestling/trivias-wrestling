

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MI Wrestling Persona",
  "type": "object",
  "required": ["id", "wrestlerId", "name"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
    },
    "wrestlerId": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "nickname": {
      "type": ["string", "null"]
    },
    "image": {
      "type": ["string", "null"]
    },
    "themeSong": {
      "type": ["string", "null"]
    },
    "finisher": {
      "type": ["string", "null"]
    },
    "description": {
      "type": ["string", "null"]
    },
    "startDate": {
      "type": ["string", "null"],
      "format": "date"
    },
    "endDate": {
      "type": ["string", "null"],
      "format": "date"
    },
    "status": {
      "type": ["string", "null"]
    }
  },
  "additionalProperties": true
}
